# Copy to .env and fill in, or let ./install.sh create it for you.
PORTAL_TITLE="SOK Research Desk"
CONTACT_EMAIL=you@example.org
HTTP_PORT=8080
SITE_NAME=resdesk.localhost
# Public address people will use. Goes into citations, OAI-PMH and MARC 856 links.
BASE_URL=http://localhost:8080
ADMIN_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
MEILI_MASTER_KEY=a-long-random-string-at-least-16-bytes
# Optional
# LIBRARY_DIR=/Volumes/Books      folder of IA-style item folders (local, USB or NAS mount);
#                                  appears inside Research Desk as /library-source
# QUEUE_WORKERS=2          parallel ingest workers (2-4 is polite to archive.org)
# DEV_MODE=0               1 = run code live from this folder (./resdesk.sh dev on)
# TIMEZONE=Asia/Kolkata
# COUNTRY=India
# CURRENCY=INR
# GUNICORN_WORKERS=2
# RESDESK_IMAGE=ghcr.io/servantsofknowledge/researchdesk
# RESDESK_TAG=latest
# FRAPPE_BRANCH=version-16
