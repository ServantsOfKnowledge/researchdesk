# Copy to .env and fill in, or let ./install.sh create it for you.
PORTAL_TITLE="SoK Research Desk"
CONTACT_EMAIL=you@example.org
HTTP_PORT=8080
SITE_NAME=resdesk.localhost
# Public address people will use. Goes into citations, OAI-PMH and MARC 856 links.
BASE_URL=http://localhost:8080
ADMIN_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
MEILI_MASTER_KEY=a-long-random-string-at-least-16-bytes
# Optional
# TIMEZONE=Asia/Kolkata
# COUNTRY=India
# CURRENCY=INR
# GUNICORN_WORKERS=2
# RESDESK_IMAGE=ghcr.io/omshivaprakash/sok-resdesk
# RESDESK_TAG=latest
# FRAPPE_BRANCH=version-16
